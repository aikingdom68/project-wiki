{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Project Wiki Export Plan",
  "type": "object",
  "required": ["ok", "readOnly", "phase", "inspectionLevel", "binding", "adapter", "artifacts", "plan", "summary", "warnings", "nonGoals"],
  "properties": {
    "ok": { "type": "boolean" },
    "readOnly": { "const": true },
    "phase": { "const": "p4_4_export_planning" },
    "inspectionLevel": { "type": "integer", "minimum": 1 },
    "projectRoot": { "type": ["string", "null"] },
    "binding": {
      "type": "object",
      "required": ["status", "config"],
      "properties": {
        "status": { "type": "string" },
        "config": { "type": "object" },
        "errors": { "type": "array" }
      },
      "additionalProperties": false
    },
    "adapter": { "$ref": "#/definitions/adapter" },
    "artifacts": {
      "type": "object",
      "required": ["existing", "truncated"],
      "properties": {
        "existing": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
        "truncated": { "const": false }
      },
      "additionalProperties": false
    },
    "plan": {
      "type": "object",
      "required": ["planningOnly", "executionEnabled", "exportEndpointAvailable", "exportAllowed", "exportWriteEnabled", "writeEnabled", "dependencyInstallEnabled", "publisherCommandEnabled", "uploadEnabled", "serverStartEnabled", "target", "profile", "sourceScope", "outputRoot", "rollback", "dependencyBoundary", "confirmationGates"],
      "properties": {
        "planningOnly": { "const": true },
        "executionEnabled": { "const": false },
        "exportEndpointAvailable": { "const": false },
        "exportAllowed": { "const": false },
        "exportWriteEnabled": { "const": false },
        "writeEnabled": { "const": false },
        "dependencyInstallEnabled": { "const": false },
        "publisherCommandEnabled": { "const": false },
        "uploadEnabled": { "const": false },
        "serverStartEnabled": { "const": false },
        "target": { "$ref": "#/definitions/planningString" },
        "profile": { "$ref": "#/definitions/planningString" },
        "sourceScope": {
          "type": "object",
          "required": ["status", "roots"],
          "properties": {
            "status": { "const": "needs_confirmation" },
            "roots": { "type": "array", "items": { "$ref": "#/definitions/sourceRoot" } }
          },
          "additionalProperties": false
        },
        "outputRoot": { "$ref": "#/definitions/outputRoot" },
        "rollback": {
          "type": "object",
          "required": ["strategy", "confirmed", "willWrite"],
          "properties": {
            "strategy": { "type": ["string", "null"] },
            "confirmed": { "const": false },
            "willWrite": { "const": false },
            "backupRoot": { "$ref": "#/definitions/outputRoot" }
          },
          "additionalProperties": false
        },
        "dependencyBoundary": {
          "type": "object",
          "required": ["requiredToExecute", "toolchain", "installAllowed", "dependencyInstallAllowed", "commandExecutionAllowed", "publisherCommandAllowed", "uploadAllowed", "serverStartAllowed", "exportAllowed", "allowedNow", "blockedUntilConfirmation"],
          "properties": {
            "requiredToExecute": { "type": "integer", "minimum": 3 },
            "toolchain": { "type": ["string", "null"] },
            "installAllowed": { "const": false },
            "dependencyInstallAllowed": { "const": false },
            "commandExecutionAllowed": { "const": false },
            "publisherCommandAllowed": { "const": false },
            "uploadAllowed": { "const": false },
            "serverStartAllowed": { "const": false },
            "exportAllowed": { "const": false },
            "allowedNow": { "type": "array", "minItems": 1, "items": { "type": "string" } },
            "blockedUntilConfirmation": { "type": "array", "minItems": 1, "items": { "type": "string" } }
          },
          "additionalProperties": false
        },
        "confirmationGates": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      },
      "additionalProperties": false
    },
    "summary": {
      "type": "object",
      "required": ["adapterState", "target", "profile", "outputRoot", "outputRootSafe", "existingArtifacts", "heavyActionsAvailable", "exportAllowed", "executionAllowed", "writeAllowed", "dependencyInstallAllowed", "commandExecutionAllowed", "uploadAllowed", "serverStartAllowed", "confirmationRequired"],
      "properties": {
        "adapterState": { "type": "string" },
        "target": { "type": ["string", "null"] },
        "profile": { "type": ["string", "null"] },
        "outputRoot": { "type": ["string", "null"] },
        "outputRootSafe": { "type": "boolean" },
        "existingArtifacts": { "type": "integer", "minimum": 0 },
        "heavyActionsAvailable": { "const": false },
        "exportAllowed": { "const": false },
        "executionAllowed": { "const": false },
        "writeAllowed": { "const": false },
        "dependencyInstallAllowed": { "const": false },
        "commandExecutionAllowed": { "const": false },
        "uploadAllowed": { "const": false },
        "serverStartAllowed": { "const": false },
        "confirmationRequired": { "const": true }
      },
      "additionalProperties": false
    },
    "warnings": { "type": "array", "items": { "type": "string" } },
    "nonGoals": { "type": "array", "minItems": 1, "items": { "type": "string" } }
  },
  "additionalProperties": false,
  "definitions": {
    "adapter": {
      "type": "object",
      "required": ["adapterId", "state", "executionEnabled", "dependencyLevelToExecute", "artifacts", "warnings", "confirmationRequiredBefore", "nextSteps"],
      "properties": {
        "adapterId": { "const": "export" },
        "state": { "enum": ["not_installed", "env_unavailable", "runtime_failed", "unsupported", "empty_result", "configured"] },
        "executionEnabled": { "const": false },
        "dependencyLevelToExecute": { "type": "integer", "minimum": 0 },
        "artifacts": { "type": "array", "items": { "$ref": "#/definitions/artifact" } },
        "warnings": { "type": "array", "items": { "type": "string" } },
        "confirmationRequiredBefore": { "type": "array", "items": { "type": "string" } },
        "nextSteps": { "type": "array", "items": { "type": "string" } },
        "metadata": { "type": "object", "additionalProperties": false }
      },
      "additionalProperties": false
    },
    "artifact": {
      "type": "object",
      "required": ["path", "exists"],
      "properties": {
        "path": { "type": "string" },
        "exists": { "type": "boolean" },
        "kind": { "type": "string" },
        "error": { "type": "string" },
        "summary": { "type": "object" }
      },
      "additionalProperties": false
    },
    "planningString": {
      "type": "object",
      "required": ["value", "source", "confirmed"],
      "properties": {
        "value": { "type": ["string", "null"] },
        "source": { "type": "string" },
        "confirmed": { "const": false }
      },
      "additionalProperties": false
    },
    "sourceRoot": {
      "type": "object",
      "required": ["role", "path", "confirmed"],
      "properties": {
        "role": { "type": "string" },
        "path": { "type": "string" },
        "confirmed": { "const": false }
      },
      "additionalProperties": false
    },
    "outputRoot": {
      "type": "object",
      "required": ["path", "safe", "willWrite"],
      "properties": {
        "path": { "type": ["string", "null"] },
        "safe": { "type": "boolean" },
        "willWrite": { "const": false }
      },
      "additionalProperties": false
    }
  }
}
